{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sentier-dev/sentier-importers/main/openlineage/facets/1-0-0/SentierExecutionRunFacet.json",
  "$defs": {
    "SentierExecutionRunFacet": {
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/RunFacet"
        },
        {
          "type": "object",
          "properties": {
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "contributor": {
              "type": "string"
            }
          },
          "required": [
            "startedAt"
          ]
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "sentier_execution": {
      "$ref": "#/$defs/SentierExecutionRunFacet"
    }
  }
}
